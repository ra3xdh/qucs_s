<Component CD4053>
  <Description>
CMOS Triple 2-Channel Analog Multiplexer/Demultiplexer
XSPICE logic, transistor level switches
Typical rON fitted to TI SCHS047 datasheet
Ngspice only
  </Description>
  <Model>
.Def:AnalogSwitches_CD4053 _net0 _net1 _net2 _net3 _net4 _net5 _net6 _net7 _net8 _net9 _net10 _net11 _net12 _net13 _net14 _net15
Sub:X1 _net0 _net1 _net2 _net3 _net4 _net5 _net6 _net7 _net8 _net9 _net10 _net11 _net12 _net13 _net14 _net15 gnd Type="CD4053_cir"
.Def:End
  </Model>
  <ModelIncludes "CD4053.cir.lst">
  <Spice>
* CD4053B CMOS Triple 2-Channel Analog Multiplexer/Demultiplexer
* XSPICE logic, transistor level CMOS transmission gates.
* Logic thresholds and gate drive follow the supply pins.
* Pins 1..16 as in the DIP-16 package
.SUBCKT CD4053B by bx cy cxy cx inh vee vss c b a ax ay axy bxy vdd
XINA a da vdd vss CD405X_IN
ANA da dna inv1
XINB b db vdd vss CD405X_IN
ANB db dnb inv1
XINC c dc vdd vss CD405X_IN
ANC dc dnc inv1
XININH inh dinh vdd vss CD405X_IN
ANINH dinh dninh inv1
* channel is on when its address matches and INH is low
AAX [dna dninh] eax and1
AAY [da dninh] eay and1
ABX [dnb dninh] ebx and1
ABY [db dninh] eby and1
ACX [dnc dninh] ecx and1
ACY [dc dninh] ecy and1
AOUT [eax eay ebx eby ecx ecy] [sax say sbx sby scx scy] dac1
XSAX ax axy sax vdd vee CD405X_SW
XSAY ay axy say vdd vee CD405X_SW
XSBX bx bxy sbx vdd vee CD405X_SW
XSBY by bxy sby vdd vee CD405X_SW
XSCX cx cxy scx vdd vee CD405X_SW
XSCY cy cxy scy vdd vee CD405X_SW
RQ vdd vss 1e9
* Logic input: normalised to VDD-VSS, CMOS thresholds 30% / 70% of supply
.SUBCKT CD405X_IN in dout vdd vss
BN n 0 V=(V(in)-V(vss))/max(V(vdd)-V(vss),0.1)
AN [n] [dout] adc1
CIN in vss 5p
.model adc1 adc_bridge(in_low=0.3 in_high=0.7)
.ENDS CD405X_IN
*
* Transmission gate, en is 0..1 and is level shifted to VEE..VDD
.SUBCKT CD405X_SW io1 io2 en vdd vee
BGN gn 0 V=V(vee)+V(en)*(V(vdd)-V(vee))
BGP gp 0 V=V(vdd)-V(en)*(V(vdd)-V(vee))
MN io1 gn io2 vee CD405XN
MP io1 gp io2 vdd CD405XP
DN1 vee io1 CD405XD
DN2 vee io2 CD405XD
DP1 io1 vdd CD405XD
DP2 io2 vdd CD405XD
.model CD405XD D(IS=1f)
* CD4007 parameters from the CD4066 model; W, RD, RS fitted to the
* typical rON of TI SCHS047 (470/180/125 Ohm at VDD=5/10/15 V)
.MODEL CD405XN NMOS(LEVEL=1 VTO=1.44 KP=320u L=10u W=36u GAMMA=0 PHI=.6
+ LAMBDA=10m RD=18 RS=18 IS=16.64p CBD=2.0p CBS=2.0p CGSO=0.1p CGDO=0.1p
+ PB=.8 TOX=1200n)
.MODEL CD405XP PMOS(LEVEL=1 VTO=-1.2 KP=110u L=10u W=72u GAMMA=0 PHI=.6
+ LAMBDA=40m RD=18 RS=18 IS=16.64p CBD=4.0p CBS=4.0p CGSO=0.2p CGDO=0.2p
+ PB=.8 TOX=1200n)
.ENDS CD405X_SW
*
.model inv1 d_inverter(rise_delay=10n fall_delay=10n)
* shortcut: fixed delay, near the 10 V datasheet value; real tpd scales with VDD
.model and1 d_and(rise_delay=100n fall_delay=100n)
.model dac1 dac_bridge(out_low=0 out_high=1 out_undef=0.5 t_rise=50n t_fall=50n)
.ENDS CD4053B

.SUBCKT AnalogSwitches_CD4053  gnd _net0 _net1 _net2 _net3 _net4 _net5 _net6 _net7 _net8 _net9 _net10 _net11 _net12 _net13 _net14 _net15 
X1 _net0 _net1 _net2 _net3 _net4 _net5 _net6 _net7 _net8 _net9 _net10 _net11 _net12 _net13 _net14 _net15 CD4053B
.ENDS
